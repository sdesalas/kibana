{
  "type": "plugin",
  "id": "@kbn/bootcamp-plugin",
  "owner": "@elastic/obs-ux-logs-team",
  "group": "platform",
  "visibility": "shared",
  "description": "Bootcamp plugin for Kibana bootcamp",
  "plugin": {
    "id": "bootcamp",
    "server": true,
    "browser": true,
    "configPath": [ "xpack", "bootcamp" ],
    "requiredPlugins": [ "share" ],
    "optionalPlugins": [ "features" ],
    "requiredBundles": [ "kibanaReact" ]
  }
}